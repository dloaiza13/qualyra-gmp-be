  "info": {
    "title": "Qualyra GMP API",
    "description": "Secure multi-tenant quality management API.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "qualyra_refresh"
      }
    },
    "schemas": {
      "RegisterCompanyDto": {
        "type": "object",
        "properties": {
          "tenantName": {
            "type": "string",
            "example": "ACME Pharma"
          },
          "tenantSlug": {
            "type": "string",
            "example": "acme-pharma"
          },
          "adminName": {
            "type": "string",
            "example": "Jane Doe"
          },
          "email": {
            "type": "string",
            "example": "jane@acme.example"
          },
          "password": {
            "type": "string",
            "example": "a long passphrase",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": [
          "tenantName",
          "tenantSlug",
          "adminName",
          "email",
          "password"
        ]
      },
      "AuthenticatedUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "displayName": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "INVITED",
              "ACTIVE",
              "LOCKED",
              "DISABLED"
            ]
          },
          "emailVerifiedAt": {
            "type": "object",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "status"
        ]
      },
      "TenantSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ]
      },
      "AuthenticationResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Short-lived RS256 access token."
          },
          "csrfToken": {
            "type": "string",
            "description": "Double-submit token for cookie-based operations."
          },
          "user": {
            "$ref": "#/components/schemas/AuthenticatedUserDto"
          },
          "tenant": {
            "$ref": "#/components/schemas/TenantSummaryDto"
          }
        },
        "required": [
          "accessToken",
          "csrfToken",
          "user",
          "tenant"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "tenant": {
            "type": "string",
            "example": "acme-pharma"
          },
          "email": {
            "type": "string",
            "example": "jane@acme.example"
          },
          "password": {
            "type": "string",
            "example": "a long passphrase"
          }
        },
        "required": [
          "tenant",
          "email",
          "password"
        ]
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AuthenticatedUserDto"
          },
          "tenant": {
            "$ref": "#/components/schemas/TenantSummaryDto"
          }
        },
        "required": [
          "user",
          "tenant"
        ]
      },
      "SessionResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "device": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastUsedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "isCurrent": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "REVOKED",
              "EXPIRED"
            ]
          }
        },
        "required": [
          "id",
          "device",
          "createdAt",
          "lastUsedAt",
          "expiresAt",
          "isCurrent",
          "status"
        ]
      },
      "TenantEmailDto": {
        "type": "object",
        "properties": {
          "tenant": {
            "type": "string",
            "example": "acme-pharma"
          },
          "email": {
            "type": "string",
            "example": "jane@acme.example"
          }
        },
        "required": [
          "tenant",
          "email"
        ]
      },
      "NeutralResponseDto": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "accepted"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Opaque one-time token received by email."
          },
          "newPassword": {
            "type": "string",
            "example": "a new long passphrase",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "newPassword"
        ]
      },
      "TokenDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Opaque one-time token received by email."
          }
        },
        "required": [
          "token"
        ]
      }
    }
  }
}
