NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:5173

POSTGRES_PORT=5432
POSTGRES_DB=qualyra_gmp
POSTGRES_SHADOW_DB=qualyra_gmp_shadow
POSTGRES_SUPERUSER_PASSWORD=dev_superuser_change_me
POSTGRES_OWNER_USER=qualyra_owner
POSTGRES_OWNER_PASSWORD=dev_owner_change_me
POSTGRES_APP_USER=qualyra_app
POSTGRES_APP_PASSWORD=dev_app_change_me

# Local recovery tooling. Use a restricted backup identity and encrypted storage
# outside the workstation in production. On Windows, D:/qualyra-gmp/backups is
# recommended when drive C: is constrained.
QUALYRA_BACKUP_ROOT=./.local/backups
QUALYRA_BACKUP_USER=postgres
QUALYRA_BACKUP_PASSWORD=dev_superuser_change_me
QUALYRA_POSTGRES_SERVICE=postgres
QUALYRA_POSTGRES_HOST=127.0.0.1

MIGRATION_DATABASE_URL=postgresql://qualyra_owner:dev_owner_change_me@localhost:5432/qualyra_gmp
DATABASE_URL=postgresql://qualyra_app:dev_app_change_me@localhost:5432/qualyra_gmp
SHADOW_DATABASE_URL=postgresql://qualyra_owner:dev_owner_change_me@localhost:5432/qualyra_gmp_shadow

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_OPERATION_TIMEOUT_MS=1000

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=false
SMTP_FROM=Qualyra GMP <no-reply@qualyra.local>

JWT_ACCESS_PRIVATE_KEY=file:./.local/keys/jwt-private.pem
JWT_ACCESS_PUBLIC_KEY=file:./.local/keys/jwt-public.pem
JWT_ISSUER=qualyra-gmp
JWT_AUDIENCE=qualyra-gmp-web
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
INVITATION_TTL_HOURS=72
EMAIL_VERIFICATION_TTL_HOURS=24

COOKIE_SECURE=false
COOKIE_NAME=qualyra_refresh
CSRF_COOKIE_NAME=qualyra_csrf
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Convenient for local development. Use false for a commercially controlled launch.
ALLOW_PUBLIC_TENANT_REGISTRATION=true
TRUST_PROXY=false
REQUEST_BODY_LIMIT=1mb
OPERATIONAL_READINESS_TIMEOUT_MS=5000

# Prometheus-compatible operational metrics. Replace the token in every shared
# environment; the endpoint never accepts an unauthenticated scrape.
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=qualyra_local_metrics_token

# Managed CAPA evidence. Point this at D: on Windows when C: is constrained,
# for example D:/qualyra-gmp/evidence.
CAPA_EVIDENCE_STORAGE_DRIVER=local
CAPA_EVIDENCE_STORAGE_ROOT=./.local/evidence
CAPA_EVIDENCE_MAX_BYTES=10485760
PHOTO_EVIDENCE_MAX_BYTES=10485760
PHOTO_EVIDENCE_TENANT_QUOTA_BYTES=2147483648
CAPA_EVIDENCE_UPLOAD_TTL_HOURS=24
CAPA_EVIDENCE_S3_ENDPOINT=http://localhost:9000
CAPA_EVIDENCE_S3_REGION=us-east-1
CAPA_EVIDENCE_S3_BUCKET=qualyra-capa-evidence
CAPA_EVIDENCE_S3_ACCESS_KEY=qualyra
CAPA_EVIDENCE_S3_SECRET_KEY=qualyra_dev_change_me
CAPA_EVIDENCE_S3_FORCE_PATH_STYLE=true
CAPA_EVIDENCE_S3_AUTO_CREATE_BUCKET=true
CAPA_EVIDENCE_SCANNER=built-in
CAPA_EVIDENCE_CLAMAV_HOST=127.0.0.1
CAPA_EVIDENCE_CLAMAV_PORT=3310
CAPA_EVIDENCE_CLAMAV_TIMEOUT_MS=30000
CAPA_EVIDENCE_RETENTION_ENABLED=true
CAPA_EVIDENCE_RETENTION_INTERVAL_MINUTES=60

# Optional managed-evidence Docker profile. Change these before shared use.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=qualyra
MINIO_ROOT_PASSWORD=qualyra_dev_change_me
CLAMAV_PORT=3310

# Durable due-soon, overdue, and escalation email monitor.
CAPA_MONITORING_ENABLED=true
CAPA_MONITORING_INTERVAL_MINUTES=15

# Transactional notification outbox. Replace the development-only key with
# 32 random bytes encoded as 64 hexadecimal characters before production.
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_LOCK_TIMEOUT_MINUTES=15
OUTBOX_RETRY_BASE_SECONDS=30
OUTBOX_RETRY_MAX_SECONDS=3600
OUTBOX_PAYLOAD_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
