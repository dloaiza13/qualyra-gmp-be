generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum TenantPlan {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum UserStatus {
  INVITED
  ACTIVE
  LOCKED
  DISABLED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum SecurityEventOutcome {
  SUCCESS
  FAILURE
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum DocumentType {
  POLICY
  SOP
  WORK_INSTRUCTION
  FORM
  SPECIFICATION
  OTHER
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  EFFECTIVE
  OBSOLETE
}

enum DocumentVersionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  EFFECTIVE
  SUPERSEDED
  OBSOLETE
}

enum DocumentWorkflowStatus {
  PENDING_REVIEW
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum DocumentSignatureMeaning {
  DOCUMENT_RELEASE
  DOCUMENT_OBSOLESCENCE
}

enum DocumentAuthenticationMethod {
  PASSWORD_REAUTHENTICATION
}

enum DocumentPeriodicReviewStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum DocumentPeriodicReviewDecision {
  CONFIRM_EFFECTIVE
  REVISION_REQUIRED
}

enum TrainingAssignmentStatus {
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum TrainingSignatureMeaning {
  TRAINING_ACKNOWLEDGEMENT
}

enum TrainingAuthenticationMethod {
  PASSWORD_REAUTHENTICATION
}

enum DeviationStatus {
  REPORTED
  UNDER_INVESTIGATION
  INVESTIGATION_COMPLETED
  CANCELLED
}

enum DeviationSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum DeviationRootCauseMethod {
  FIVE_WHYS
  ISHIKAWA
  FAULT_TREE_ANALYSIS
  OTHER
}

enum DeviationSignatureMeaning {
  INVESTIGATION_COMPLETION
}

enum DeviationAuthenticationMethod {
  PASSWORD_REAUTHENTICATION
}

model Tenant {
  id                      String                   @id @default(uuid()) @db.Uuid
  name                    String                   @db.VarChar(200)
  slug                    String                   @unique(map: "tenants_slug_key") @db.VarChar(63)
  status                  TenantStatus             @default(ACTIVE)
  plan                    TenantPlan               @default(TRIAL)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  users                   User[]
  roles                   Role[]
  rolePermissions         RolePermission[]
  userRoles               UserRole[]
  sessions                Session[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  invitations             Invitation[]
  invitationRoles         InvitationRole[]
  securityEvents          SecurityEvent[]
  outboxMessages          OutboxMessage[]
  documents               Document[]
  documentVersions        DocumentVersion[]
  documentWorkflows       DocumentWorkflow[]
  documentReleases        DocumentRelease[]
  documentObsolescences   DocumentObsolescence[]
  documentPeriodicReviews DocumentPeriodicReview[]
  trainingAssignments     TrainingAssignment[]
  deviationSequences      DeviationSequence[]
  deviations              Deviation[]
  deviationInvestigations DeviationInvestigation[]

  @@map("tenants")
}

model User {
  id                                String                   @id @default(uuid()) @db.Uuid
  tenantId                          String                   @map("tenant_id") @db.Uuid
  email                             String                   @db.VarChar(320)
  displayName                       String                   @map("display_name") @db.VarChar(200)
  passwordHash                      String                   @map("password_hash")
  status                            UserStatus               @default(INVITED)
  emailVerifiedAt                   DateTime?                @map("email_verified_at") @db.Timestamptz(3)
  failedLoginCount                  Int                      @default(0) @map("failed_login_count")
  lockedUntil                       DateTime?                @map("locked_until") @db.Timestamptz(3)
  passwordChangedAt                 DateTime?                @map("password_changed_at") @db.Timestamptz(3)
  createdAt                         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRoles                         UserRole[]
  sessions                          Session[]
  refreshTokens                     RefreshToken[]
  passwordResetTokens               PasswordResetToken[]
  emailVerificationTokens           EmailVerificationToken[]
  invitationsCreated                Invitation[]             @relation("InvitationCreator")
  securityEventsAsActor             SecurityEvent[]          @relation("SecurityEventActor")
  securityEventsAsSubject           SecurityEvent[]          @relation("SecurityEventSubject")
  documentsOwned                    Document[]               @relation("DocumentOwner")
  documentsCreated                  Document[]               @relation("DocumentCreator")
  documentVersionsCreated           DocumentVersion[]        @relation("DocumentVersionCreator")
  documentWorkflowsRequested        DocumentWorkflow[]       @relation("DocumentWorkflowRequester")
  documentReviewAssignments         DocumentWorkflow[]       @relation("DocumentWorkflowReviewer")
  documentApprovalAssignments       DocumentWorkflow[]       @relation("DocumentWorkflowApprover")
  documentReleases                  DocumentRelease[]        @relation("DocumentReleaseSigner")
  documentObsolescences             DocumentObsolescence[]   @relation("DocumentObsolescenceSigner")
  documentsPeriodicReviewConfigured Document[]               @relation("DocumentPeriodicReviewConfiguration")
  documentPeriodicReviewAssignments DocumentPeriodicReview[] @relation("DocumentPeriodicReviewAssignee")
  documentPeriodicReviewsScheduled  DocumentPeriodicReview[] @relation("DocumentPeriodicReviewScheduler")
  trainingAssignmentsReceived       TrainingAssignment[]     @relation("TrainingAssignmentAssignee")
  trainingAssignmentsCreated        TrainingAssignment[]     @relation("TrainingAssignmentCreator")
  trainingAssignmentsCancelled      TrainingAssignment[]     @relation("TrainingAssignmentCanceller")
  deviationsReported                Deviation[]               @relation("DeviationReporter")
  deviationInvestigations           Deviation[]               @relation("DeviationInvestigator")
  deviationsTriaged                 Deviation[]               @relation("DeviationTriager")
  deviationsCancelled               Deviation[]               @relation("DeviationCanceller")
  deviationInvestigationsCompleted  DeviationInvestigation[]  @relation("DeviationInvestigationCompleter")

  @@unique([tenantId, id], map: "users_tenant_id_id_key")
  @@unique([tenantId, email], map: "users_tenant_id_email_key")
  @@index([tenantId, status], map: "users_tenant_id_status_idx")
  @@map("users")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique(map: "permissions_code_key") @db.VarChar(100)
  description     String           @db.VarChar(300)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  name            String           @db.VarChar(100)
  description     String?          @db.VarChar(300)
  isSystem        Boolean          @default(false) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  invitationRoles InvitationRole[]

  @@unique([tenantId, id], map: "roles_tenant_id_id_key")
  @@unique([tenantId, name], map: "roles_tenant_id_name_key")
  @@map("roles")
}

model RolePermission {
  tenantId     String     @map("tenant_id") @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  role         Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([tenantId, roleId, permissionId])
  @@index([permissionId], map: "role_permissions_permission_id_idx")
  @@map("role_permissions")
}

model UserRole {
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  role      Role     @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, userId, roleId])
  @@index([tenantId, roleId], map: "user_roles_tenant_id_role_id_idx")
  @@map("user_roles")
}

model Session {
  id                    String                 @id @default(uuid()) @db.Uuid
  tenantId              String                 @map("tenant_id") @db.Uuid
  userId                String                 @map("user_id") @db.Uuid
  status                SessionStatus          @default(ACTIVE)
  userAgent             String?                @map("user_agent") @db.VarChar(1024)
  ipAddress             String?                @map("ip_address") @db.Inet
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt            DateTime               @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt             DateTime               @map("expires_at") @db.Timestamptz(3)
  revokedAt             DateTime?              @map("revoked_at") @db.Timestamptz(3)
  revokeReason          String?                @map("revoke_reason") @db.VarChar(300)
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                  User                   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  refreshTokens         RefreshToken[]
  documentReleases      DocumentRelease[]      @relation("DocumentReleaseSession")
  documentObsolescences DocumentObsolescence[] @relation("DocumentObsolescenceSession")
  trainingCompletions   TrainingAssignment[]   @relation("TrainingCompletionSession")
  deviationInvestigationCompletions DeviationInvestigation[] @relation("DeviationInvestigationSession")

  @@unique([tenantId, userId, id], map: "sessions_tenant_id_user_id_id_key")
  @@index([tenantId, userId, status], map: "sessions_tenant_id_user_id_status_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

model RefreshToken {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  sessionId         String         @map("session_id") @db.Uuid
  tokenHash         String         @unique(map: "refresh_tokens_token_hash_key") @map("token_hash") @db.VarChar(64)
  parentTokenId     String?        @map("parent_token_id") @db.Uuid
  replacedByTokenId String?        @unique(map: "refresh_tokens_replaced_by_token_id_key") @map("replaced_by_token_id") @db.Uuid
  issuedAt          DateTime       @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt         DateTime       @map("expires_at") @db.Timestamptz(3)
  usedAt            DateTime?      @map("used_at") @db.Timestamptz(3)
  revokedAt         DateTime?      @map("revoked_at") @db.Timestamptz(3)
  reuseDetectedAt   DateTime?      @map("reuse_detected_at") @db.Timestamptz(3)
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user              User           @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  session           Session        @relation(fields: [tenantId, userId, sessionId], references: [tenantId, userId, id], onDelete: Restrict)
  parentToken       RefreshToken?  @relation("RefreshTokenParent", fields: [tenantId, userId, sessionId, parentTokenId], references: [tenantId, userId, sessionId, id], onDelete: Restrict)
  childTokens       RefreshToken[] @relation("RefreshTokenParent")
  replacedByToken   RefreshToken?  @relation("RefreshTokenReplacement", fields: [tenantId, userId, sessionId, replacedByTokenId], references: [tenantId, userId, sessionId, id], onDelete: Restrict)
  replacedTokens    RefreshToken[] @relation("RefreshTokenReplacement")

  @@unique([tenantId, userId, sessionId, id], map: "refresh_tokens_tenant_user_session_id_key")
  @@index([tenantId, userId, sessionId], map: "refresh_tokens_tenant_user_session_idx")
  @@index([expiresAt], map: "refresh_tokens_expires_at_idx")
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "password_reset_tokens_token_hash_key") @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, userId, expiresAt], map: "password_reset_tokens_tenant_user_expiry_idx")
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "email_verification_tokens_token_hash_key") @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, userId, expiresAt], map: "email_verification_tokens_tenant_user_expiry_idx")
  @@map("email_verification_tokens")
}

model Invitation {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  email           String           @db.VarChar(320)
  tokenHash       String           @unique(map: "invitations_token_hash_key") @map("token_hash") @db.VarChar(64)
  status          InvitationStatus @default(PENDING)
  invitedByUserId String           @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz(3)
  acceptedAt      DateTime?        @map("accepted_at") @db.Timestamptz(3)
  revokedAt       DateTime?        @map("revoked_at") @db.Timestamptz(3)
  lastSentAt      DateTime         @default(now()) @map("last_sent_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invitedByUser   User             @relation("InvitationCreator", fields: [tenantId, invitedByUserId], references: [tenantId, id], onDelete: Restrict)
  invitationRoles InvitationRole[]

  @@unique([tenantId, id], map: "invitations_tenant_id_id_key")
  @@index([tenantId, email, status], map: "invitations_tenant_email_status_idx")
  @@index([expiresAt], map: "invitations_expires_at_idx")
  @@map("invitations")
}

model InvitationRole {
  tenantId     String     @map("tenant_id") @db.Uuid
  invitationId String     @map("invitation_id") @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invitation   Invitation @relation(fields: [tenantId, invitationId], references: [tenantId, id], onDelete: Restrict)
  role         Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, invitationId, roleId])
  @@index([tenantId, roleId], map: "invitation_roles_tenant_role_idx")
  @@map("invitation_roles")
}

model SecurityEvent {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  actorUserId   String?              @map("actor_user_id") @db.Uuid
  subjectUserId String?              @map("subject_user_id") @db.Uuid
  eventType     String               @map("event_type") @db.VarChar(100)
  outcome       SecurityEventOutcome
  correlationId String               @map("correlation_id") @db.Uuid
  ipAddress     String?              @map("ip_address") @db.Inet
  userAgent     String?              @map("user_agent") @db.VarChar(1024)
  metadata      Json?
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actorUser     User?                @relation("SecurityEventActor", fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: Restrict)
  subjectUser   User?                @relation("SecurityEventSubject", fields: [tenantId, subjectUserId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, createdAt], map: "security_events_tenant_created_at_idx")
  @@index([tenantId, eventType, createdAt], map: "security_events_tenant_type_created_at_idx")
  @@map("security_events")
}

model OutboxMessage {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  type        String       @db.VarChar(100)
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  processedAt DateTime?    @map("processed_at") @db.Timestamptz(3)
  lastError   String?      @map("last_error")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([status, availableAt], map: "outbox_messages_status_available_at_idx")
  @@index([tenantId, createdAt], map: "outbox_messages_tenant_created_at_idx")
  @@map("outbox_messages")
}

model Document {
  id                           String                   @id @default(uuid()) @db.Uuid
  tenantId                     String                   @map("tenant_id") @db.Uuid
  code                         String                   @db.VarChar(50)
  type                         DocumentType
  status                       DocumentStatus           @default(DRAFT)
  currentVersionNumber         Int                      @default(1) @map("current_version_number")
  ownerUserId                  String                   @map("owner_user_id") @db.Uuid
  createdByUserId              String                   @map("created_by_user_id") @db.Uuid
  createdAt                    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  periodicReviewIntervalMonths Int?                     @map("periodic_review_interval_months")
  periodicReviewReviewerUserId String?                  @map("periodic_review_reviewer_user_id") @db.Uuid
  tenant                       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ownerUser                    User                     @relation("DocumentOwner", fields: [tenantId, ownerUserId], references: [tenantId, id], onDelete: Restrict)
  createdByUser                User                     @relation("DocumentCreator", fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: Restrict)
  periodicReviewReviewer       User?                    @relation("DocumentPeriodicReviewConfiguration", fields: [tenantId, periodicReviewReviewerUserId], references: [tenantId, id], onDelete: Restrict)
  versions                     DocumentVersion[]
  workflows                    DocumentWorkflow[]
  releases                     DocumentRelease[]
  obsolescences                DocumentObsolescence[]
  periodicReviews              DocumentPeriodicReview[]
  trainingAssignments          TrainingAssignment[]

  @@unique([tenantId, id], map: "documents_tenant_id_id_key")
  @@unique([tenantId, code], map: "documents_tenant_id_code_key")
  @@index([tenantId, status, updatedAt], map: "documents_tenant_status_updated_idx")
  @@index([tenantId, type, updatedAt], map: "documents_tenant_type_updated_idx")
  @@map("documents")
}

model DocumentVersion {
  id                  String                   @id @default(uuid()) @db.Uuid
  tenantId            String                   @map("tenant_id") @db.Uuid
  documentId          String                   @map("document_id") @db.Uuid
  versionNumber       Int                      @map("version_number")
  title               String                   @db.VarChar(300)
  description         String?                  @db.VarChar(2000)
  content             String
  changeSummary       String                   @map("change_summary") @db.VarChar(500)
  status              DocumentVersionStatus    @default(DRAFT)
  createdByUserId     String                   @map("created_by_user_id") @db.Uuid
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document            Document                 @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict)
  createdByUser       User                     @relation("DocumentVersionCreator", fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: Restrict)
  workflow            DocumentWorkflow?
  release             DocumentRelease?
  obsolescence        DocumentObsolescence?
  periodicReviews     DocumentPeriodicReview[]
  trainingAssignments TrainingAssignment[]

  @@unique([tenantId, id], map: "document_versions_tenant_id_id_key")
  @@unique([tenantId, documentId, id], map: "document_versions_tenant_document_id_id_key")
  @@unique([tenantId, documentId, versionNumber], map: "document_versions_tenant_document_version_key")
  @@index([tenantId, documentId, createdAt], map: "document_versions_tenant_document_created_idx")
  @@map("document_versions")
}

model DocumentWorkflow {
  id                String                 @id @default(uuid()) @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  documentId        String                 @map("document_id") @db.Uuid
  documentVersionId String                 @map("document_version_id") @db.Uuid
  requestedByUserId String                 @map("requested_by_user_id") @db.Uuid
  reviewerUserId    String                 @map("reviewer_user_id") @db.Uuid
  approverUserId    String                 @map("approver_user_id") @db.Uuid
  status            DocumentWorkflowStatus @default(PENDING_REVIEW)
  reviewComment     String?                @map("review_comment") @db.VarChar(2000)
  approvalComment   String?                @map("approval_comment") @db.VarChar(2000)
  reviewedAt        DateTime?              @map("reviewed_at") @db.Timestamptz(3)
  approvedAt        DateTime?              @map("approved_at") @db.Timestamptz(3)
  completedAt       DateTime?              @map("completed_at") @db.Timestamptz(3)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document          Document               @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict)
  documentVersion   DocumentVersion        @relation(fields: [tenantId, documentId, documentVersionId], references: [tenantId, documentId, id], onDelete: Restrict)
  requestedByUser   User                   @relation("DocumentWorkflowRequester", fields: [tenantId, requestedByUserId], references: [tenantId, id], onDelete: Restrict)
  reviewerUser      User                   @relation("DocumentWorkflowReviewer", fields: [tenantId, reviewerUserId], references: [tenantId, id], onDelete: Restrict)
  approverUser      User                   @relation("DocumentWorkflowApprover", fields: [tenantId, approverUserId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id], map: "document_workflows_tenant_id_id_key")
  @@unique([tenantId, documentVersionId], map: "document_workflows_tenant_version_key")
