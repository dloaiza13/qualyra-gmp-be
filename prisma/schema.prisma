model Deviation {
  id                    String             @id @default(uuid()) @db.Uuid
  tenantId              String             @map("tenant_id") @db.Uuid
  code                  String             @db.VarChar(24)
  title                 String             @db.VarChar(200)
  description           String             @db.VarChar(5000)
  area                  String             @db.VarChar(120)
  occurredAt            DateTime           @map("occurred_at") @db.Timestamptz(3)
  reportedByUserId      String             @map("reported_by_user_id") @db.Uuid
  status                DeviationStatus    @default(REPORTED)
  severity              DeviationSeverity?
  investigatorUserId    String?            @map("investigator_user_id") @db.Uuid
  investigationDueAt    DateTime?          @map("investigation_due_at") @db.Timestamptz(3)
  impactAssessment      String?            @map("impact_assessment") @db.VarChar(2000)
  containmentAction     String?            @map("containment_action") @db.VarChar(2000)
  triagedByUserId       String?            @map("triaged_by_user_id") @db.Uuid
  triagedAt             DateTime?          @map("triaged_at") @db.Timestamptz(3)
  cancelledByUserId     String?            @map("cancelled_by_user_id") @db.Uuid
  cancelledAt           DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason    String?            @map("cancellation_reason") @db.VarChar(500)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reportedByUser        User               @relation("DeviationReporter", fields: [tenantId, reportedByUserId], references: [tenantId, id], onDelete: Restrict)
  investigatorUser      User?              @relation("DeviationInvestigator", fields: [tenantId, investigatorUserId], references: [tenantId, id], onDelete: Restrict)
  triagedByUser         User?              @relation("DeviationTriager", fields: [tenantId, triagedByUserId], references: [tenantId, id], onDelete: Restrict)
  cancelledByUser       User?              @relation("DeviationCanceller", fields: [tenantId, cancelledByUserId], references: [tenantId, id], onDelete: Restrict)
  investigation         DeviationInvestigation?

  @@unique([tenantId, id], map: "deviations_tenant_id_id_key")
  @@unique([tenantId, code], map: "deviations_tenant_id_code_key")
  @@index([tenantId, status, createdAt], map: "deviations_tenant_status_created_idx")
  @@index([tenantId, severity, investigationDueAt], map: "deviations_tenant_severity_due_idx")
  @@index([tenantId, investigatorUserId, status], map: "deviations_tenant_investigator_status_idx")
  @@map("deviations")
}

